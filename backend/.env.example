# TeamFlow Backend Environment Configuration

# Server Port and Mode
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local fallback)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/teamflow?retryWrites=true&w=majority

# Cookie Signing Secret
COOKIE_SECRET=your_super_secret_cookie_signing_secret_min_32_characters

# JWT Token Secrets (Minimum 64-character random string)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_replace_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_replace_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Brevo (formerly Sendinblue) Transactional Email API (REQUIRED FOR PRODUCTION OTP)
# 1. Sign up for free at https://www.brevo.com
# 2. Go to "Senders, Domains & Dedicated IPs" -> Verify your sender email address (e.g., yourname@yourdomain.com or your verified Gmail/workspace email)
# 3. Go to "SMTP & API" -> "API Keys" -> Click "Generate a new API key" (v3) -> Copy key
# 4. Set BREVO_API_KEY in your Render environment variables
# 5. Set BREVO_SENDER_EMAIL to the exact verified sender address verified in Brevo
BREVO_API_KEY=xkeysib-your_brevo_v3_api_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=TeamFlow

# Security Timers
OTP_EXPIRY_MINUTES=15
RESET_EXPIRY_MINUTES=15
EMAIL_VERIFY_EXPIRY_HOURS=24

# Cloudinary Storage (Optional - falls back to dev simulation if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS Allowed Origins (Comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,https://teamflow.vercel.app
